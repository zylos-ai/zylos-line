{
  "name": "zylos-line",
  "version": "0.1.0",
  "description": "LINE Messaging API communication channel",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "zylos-line-send": "./scripts/send.js",
    "zylos-line-admin": "./scripts/admin.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "check": "for d in src hooks scripts test; do [ -d \"$d\" ] && find \"$d\" -name '*.js' -print; done | sort | xargs node --check"
  },
  "homepage": "https://github.com/zylos-ai/zylos-line#readme",
  "bugs": {
    "url": "https://github.com/zylos-ai/zylos-line/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zylos-ai/zylos-line.git"
  },
  "keywords": [
    "zylos",
    "line",
    "messaging-api",
    "agent"
  ],
  "files": [
    "SKILL.md",
    "CHANGELOG.md",
    "DESIGN.md",
    "README.md",
    "LICENSE",
    "ecosystem.config.cjs",
    "hooks/",
    "scripts/",
    "src/"
  ],
  "author": "Zylos AI",
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "vitest": "^4.1.6"
  }
}
